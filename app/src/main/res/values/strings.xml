    <!-- PPG Measure - Extended -->
    <string name="ppg_title">Camera Pulse Measurement (PPG Photoplethysmography)</string>
    <string name="ppg_description">Principle: Cover the rear camera with fingertip, flashlight shines through fingertip; each heartbeat slightly changes light transmission. Extract red channel signal frame by frame, use detrending filter, adaptive peak detection and heartbeat interval statistics to calculate heart rate and HRV(RMSSD). This is real optical measurement, not simulation.</string>
